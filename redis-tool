#!/bin/bash
set -eo pipefail

# Resolve the directory containing redis-tool. This keeps paths reliable even
# when the command is launched from a different working directory.
BASE_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
cd "$BASE_DIR"
export ANSIBLE_CONFIG="$BASE_DIR/ansible/ansible.cfg"
ORIGINAL_ARGS=("$@")

MODULES_DIR="$BASE_DIR/redis_tool_modules"

# source loads each module's functions into this shell. Absolute paths based on
# BASE_DIR ensure Bash finds the modules regardless of where the user runs the
# ./redis-tool command from.
source "$MODULES_DIR/configuration.sh"
source "$MODULES_DIR/logging.sh"
source "$MODULES_DIR/prerequisites.sh"
source "$MODULES_DIR/container_runtime.sh"
source "$MODULES_DIR/cluster_health.sh"
source "$MODULES_DIR/Docker_setup.sh"
source "$MODULES_DIR/ansible_inventory.sh"
source "$MODULES_DIR/Redis_availability_monitor.sh"

# Each CLI command has its own file so learners can follow one feature at a time.
source "$MODULES_DIR/commands/provision_cluster.sh"
source "$MODULES_DIR/commands/data_seed_and_verify.sh"
source "$MODULES_DIR/commands/status_check.sh"
source "$MODULES_DIR/commands/rolling_upgrade.sh"
source "$MODULES_DIR/commands/full_verification.sh"
source "$MODULES_DIR/commands/scale_out.sh"
source "$MODULES_DIR/commands/rollback.sh"

print_usage() {
  echo "Usage:"
  echo "  ./redis-tool provision --version 7.0.15 --masters 3 --replicas-per-master 1"
  echo "  ./redis-tool data seed --keys 1000"
  echo "  ./redis-tool data verify"
  echo "  ./redis-tool status"
  echo "  ./redis-tool upgrade --target-version 7.2.6 --strategy rolling"
  echo "  ./redis-tool verify --full"
  echo "  ./redis-tool scale --add-nodes 2"
  echo "  ./redis-tool rollback --target-version 7.0.15"
}

# Prerequisites are intentionally checked before logging or command routing.
check_prerequisites
initialize_operation_log "${ORIGINAL_ARGS[@]}"
structured_log "INFO" "all" "prerequisite_check" "success" \
  "runtime=$RUNTIME_VERSION ansible=$ANSIBLE_VERSION"
log_live_cluster_nodes || true

case "${1:-}" in
  provision)
    shift
    ensure_infra_running
    provision "$@"
    ;;
  data)
    shift
    data_command "$@"
    ;;
  status)
    shift
    status_command "$@"
    ;;
  upgrade)
    shift
    upgrade_command "$@"
    ;;
  verify)
    shift
    verify_command "$@"
    ;;
  scale)
    shift
    scale_command "$@"
    ;;
  rollback)
    shift
    rollback_command "$@"
    ;;
  *)
    print_usage
    exit 1
    ;;
esac
