#!/bin/bash
set -eo pipefail

# Resolve the directory containing redis-tool. This keeps paths reliable even
# when the command is launched from a different working directory.
BASE_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
cd "$BASE_DIR"
export ANSIBLE_CONFIG="$BASE_DIR/ansible/ansible.cfg"
ORIGINAL_ARGS=("$@")

MODULES_DIR="$BASE_DIR/redis_tool_modules"

# Load the project modules.
source "$MODULES_DIR/prerequisite.sh"
source "$MODULES_DIR/provision.sh"
source "$MODULES_DIR/status_check.sh"
source "$MODULES_DIR/logs.sh"
source "$MODULES_DIR/upgrade.sh"
source "$MODULES_DIR/verify.sh"
source "$MODULES_DIR/health.sh"
source "$MODULES_DIR/rollback.sh"
source "$MODULES_DIR/inventory.sh"
source "$MODULES_DIR/scale_out.sh"

print_usage() {
  echo "Usage:"
  echo "  ./redis-tool provision --version 7.0.15 --masters 3 --replicas-per-master 1"
  echo "  ./redis-tool data seed --keys 1000"
  echo "  ./redis-tool data verify"
  echo "  ./redis-tool status"
  echo "  ./redis-tool upgrade --target-version 7.2.6 --strategy rolling"
  echo "  ./redis-tool verify --full"
  echo "  ./redis-tool scale --add-nodes 2"
  echo "  ./redis-tool rollback --target-version 7.0.15"
}

# Show help and reject unknown commands before checking Docker or Ansible.
case "${1:-}" in
  -h|--help|help)
    print_usage
    exit 0
    ;;
  provision|data|status|upgrade|verify|scale|rollback)
    ;;
  *)
    print_usage
    exit 1
    ;;
esac

# Check the environment and start terminal/file logging.
check_prerequisites
initialize_operation_log "${ORIGINAL_ARGS[@]}"
structured_log "INFO" "all" "prerequisite_check" "success" \
  "runtime=$RUNTIME_VERSION ansible=$ANSIBLE_VERSION"
log_live_cluster_nodes || true

# Route the command to its handler. The handler runs Ansible and writes
# the command output file through tee.
case "${1:-}" in
  provision)
    shift
    provision "$@"
    ;;
  data)
    shift
    data_command "$@"
    ;;
  status)
    shift
    if [ "$#" -ne 0 ]; then
      echo "Usage: ./redis-tool status"
      exit 1
    fi
    status_command "$@"
    ;;
  upgrade)
    shift
    upgrade_command "$@"
    ;;
  verify)
    shift
    verify_command "$@"
    ;;
  scale)
    shift
    scale_command "$@"
    ;;
  rollback)
    shift
    rollback_command "$@"
    ;;
esac
